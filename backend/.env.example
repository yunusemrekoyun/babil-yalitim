PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/dbname
JWT_SECRET=change-me
ADMIN_USER=admin
ADMIN_PASS_HASH=
ADMIN_PASS=change-me-if-hash-empty
ACCESS_TOKEN_EXPIRES_IN=1h
COOKIE_DOMAIN=
CROSS_SITE_COOKIES=0
FRONTEND_ORIGIN=https://your-frontend.example
EXTRA_ALLOWED_ORIGINS=https://staging.example,https://preview.example
BASE_URL=https://your-backend.example
VERCEL_PREVIEW_ALLOWED=1

MEDIA_ROOT=./media
MEDIA_PUBLIC_PATH=/media
MEDIA_BASE_URL=https://your-backend.example/media
MEDIA_BLOGS_FOLDER=blogs
MEDIA_JOURNALS_FOLDER=journals
MEDIA_PROJECTS_FOLDER=projects
MEDIA_SERVICES_FOLDER=services

LIKE_SALT=change-me
COMMENT_EMAIL_SALT=change-me
MAX_VIDEO_SIZE_MB=200
VERTICAL_MIN_RATIO=1.5
ANALYTICS_RETENTION_DAYS=180

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
CONTACT_TO_EMAIL=your-gmail@gmail.com
CONTACT_FROM_EMAIL=your-gmail@gmail.com
